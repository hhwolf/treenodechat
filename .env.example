# Hosted Threadline (configure in Vercel, never commit real values)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
THREADLINE_ACCESS_TOKEN=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6-sol

# Optional: read-only access to private GitHub repositories
GITHUB_TOKEN=

# Optional model tuning
OPENAI_REASONING_EFFORT=medium

# Optional sandbox timeout in milliseconds (default: 40 minutes)
THREADLINE_SANDBOX_TIMEOUT=2400000
